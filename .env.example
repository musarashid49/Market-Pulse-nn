# =============================================================================
# .env.example — API Key Template for market-pulse-nn
# =============================================================================
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored — NEVER commit real keys to version control.
#
#   cp .env.example .env
#
# =============================================================================

# ── Reddit API (https://www.reddit.com/prefs/apps) ──────────────────────────
# Create a "script" type app. Use any redirect URI (e.g. http://localhost)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ── Twitter / X API v2 (https://developer.twitter.com/en/portal) ────────────
# Basic tier ($100/month) gives 10,000 tweets/month read access.
# Free tier gives very limited access — use Reddit/RSS as primary sources.
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ── Optional: Hugging Face (for private model access) ───────────────────────
# Not required — ProsusAI/finbert is public
HF_TOKEN=your_huggingface_token_here
